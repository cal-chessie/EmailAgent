# Gmail API
GMAIL_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GMAIL_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GMAIL_USER_EMAIL=inbox@yourcompany.com

# Google Calendar
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Google Sheets
GOOGLE_SHEET_ID=your-sheet-id
GOOGLE_SHEET_TAB_NAME=Leads

# WhatsApp Cloud API
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token

# OpenAI
OPENAI_API_KEY=sk-...

# Email config
INBOUND_EMAIL_FILTER=from:newlead@solar.com OR subject:*solar*
POLL_INTERVAL_MS=30000

# Dashboard (http://localhost:3000)
DASHBOARD_PORT=3000
DASHBOARD_AUTH_TOKEN=change-me-to-a-strong-random-token

# Logging
LOG_LEVEL=INFO
